# Copy to .env and fill in HAVADIS_SECRET_KEY. Every other line shows its default.

# Required. Generate with: openssl rand -base64 32 (or: docker compose run --rm migrate havadis keygen). Alternatively set HAVADIS_SECRET_KEY_FILE to a Docker secret path, and set exactly one of the two.
HAVADIS_SECRET_KEY=

# The public address of this instance; http or https, no credentials, query or fragment.
HAVADIS_BASE_URL=http://localhost:4000

# The host address the web port is published on. There is no sign-in until the accounts release, so keep loopback; 0.0.0.0 exposes an unauthenticated instance.
HAVADIS_BIND=127.0.0.1

# The host port for the web service (the container always listens on 4000).
HAVADIS_PORT=4000

# Minutes between ingestion cycles (5 to 1440).
HAVADIS_INGEST_INTERVAL_MINUTES=15

# Hours before a CVE record or the KEV list is refreshed (1 to 168).
HAVADIS_ENRICH_INTERVAL_HOURS=6

# The most CVE lookups for SSVC per enrichment run (0 to 5000).
HAVADIS_SSVC_MAX_LOOKUPS=300

# The time budget in milliseconds for those lookups per run (1000 to 600000).
HAVADIS_SSVC_BUDGET_MS=60000

# How many feeds are fetched at once (1 to 32).
HAVADIS_FETCH_CONCURRENCY=8

# Internal feed hosts the worker may contact: exact hostnames or IPs, comma-separated, no CIDR. Empty keeps every internal range blocked.
HAVADIS_EGRESS_ALLOW_HOSTS=

# One of debug, info, warn, error.
HAVADIS_LOG_LEVEL=info

# Outbound proxy for the worker. Set one form of each (upper or lower case), and keep localhost,127.0.0.1,::1 in NO_PROXY.
# HTTPS_PROXY=http://proxy.example:3128
# HTTP_PROXY=http://proxy.example:3128
# NO_PROXY=localhost,127.0.0.1,::1
